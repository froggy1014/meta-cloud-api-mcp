{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "lib": ["ES2022"],
        "types": ["node"],
        "noEmit": true
    },
    "include": ["src/**/*", "test/**/*", "vitest.config.ts"]
}
